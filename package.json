{
  "name": "@oneshot-agent/sdk",
  "version": "0.36.0",
  "description": "Autonomous Agent SDK for executing real-world commercial transactions with automatic x402 payments",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "default": "./dist/receipt.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "receipt": [
        "dist/receipt.d.ts"
      ]
    }
  },
  "bin": {
    "oneshot-verify-receipt": "./dist/bin/verify-receipt.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "x402",
    "payments",
    "autonomous",
    "commerce",
    "email",
    "voice",
    "sms",
    "research",
    "blockchain",
    "usdc",
    "base"
  ],
  "dependencies": {
    "ethers": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "25.3.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@coinbase/cdp-sdk": ">=1.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@coinbase/cdp-sdk": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "OneShot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oneshot-agent/sdk.git"
  },
  "homepage": "https://docs.oneshotagent.com/sdk/overview",
  "bugs": {
    "url": "https://github.com/oneshot-agent/sdk/issues"
  }
}
